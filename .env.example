# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma database connection string.
# For local SQLite: file:./dev.db
# For production MySQL: mysql://username:password@localhost:3306/municipal_vital_db
DATABASE_URL="file:./dev.db"

# JWT_SECRET: Secret key for signing municipal portal authentication tokens
JWT_SECRET="municipal_vital_statistics_secure_jwt_token_2026"
PORT=3000
